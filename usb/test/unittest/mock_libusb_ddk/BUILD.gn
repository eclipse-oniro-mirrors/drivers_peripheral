import("//build/test.gni")
import("./../../../usb.gni")

module_output_path = "drivers_peripheral_usb/drivers_peripheral_usb"

config("mock_libusb_ddk_private_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "include",
    "../mock_libusb/mock",
    "${usb_driver_path}/ddk_service/usb_service/include",
    "${usb_driver_path}/libusb_adapter/include",
    "${usb_driver_path}/hdi_service/include",
    "${usb_driver_path}/ddk/host/include",
    "${usb_driver_path}/ddk_service/common/include",
    "${usb_driver_path}/interfaces/ddk/host",
    "${usb_driver_path}/interfaces/ddk/common",
    "${usb_driver_path}/interfaces/ddk/device",
    "${usb_driver_path}/hdf_usb/include",
    "${usb_driver_path}/utils/include",
  ]
}

# UsbDdkService is compiled from source together with LibusbAdapter, both linked
# against the mock libusb, so the whole USB DDK service can be exercised on any
# device without hardware and without the real libusb library.
ohos_unittest("test_usb_ddk_service_mock") {
  sources = [
    "../mock_libusb/mock/mock_libusb.cpp",
    "${usb_driver_path}/libusb_adapter/src/libusb_adapter.cpp",
    "${usb_driver_path}/ddk_service/usb_service/src/usb_ddk_hash.cpp",
    "${usb_driver_path}/ddk_service/usb_service/src/usb_ddk_service.cpp",
    "${usb_driver_path}/ddk_service/usb_service/src/usb_driver_manager.cpp",
    "src/mock_ddk_permission.cpp",
    "src/mock_ddk_pnp.cpp",
    "src/ddk_state_basic_test.cpp",
  ]

  defines = [ "LIBUSB_ENABLE" ]

  configs = [ ":mock_libusb_ddk_private_config" ]

  deps = [
    "${usb_driver_path}/ddk:libusb_ddk_host",
    "${usb_driver_path}/ddk:libusb_pnp_manager",
  ]

  if (is_standard_system) {
    external_deps = [
      "access_token:libaccesstoken_compat_sdk",
      "bounds_checking_function:libsec_shared",
      "c_utils:utils",
      "drivers_interface_usb:libusb_proxy_1.2",
      "drivers_interface_usb:usb_ddk_idl_headers",
      "googletest:gtest",
      "hdf_core:libhdf_host",
      "hdf_core:libhdf_utils",
      "hilog:libhilog",
      "hisysevent:libhisysevent",
      "hitrace:hitrace_meter",
      "ipc:ipc_single",
    ]
  } else {
    external_deps = [ "hilog:libhilog" ]
  }
  module_out_path = module_output_path
}
