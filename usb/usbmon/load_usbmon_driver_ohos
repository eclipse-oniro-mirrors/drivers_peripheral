function print_kernel_message()
{
    if [ -e /dev/kmsg ]
    then
        echo $1 > /dev/kmsg
    fi
    echo $1
}

function insmod_kernel_usbmon()
{
    usbmon_file_path=$1
    if [ -e $usbmon_file_path ]
    then
        insmod $usbmon_file_path
        if [ $? -eq 0 ]
        then
            print_kernel_message "kernel usbmon insmod succ"
        else
            print_kernel_message "kernel usbmon insmod failed!ret=$?"
            return 1
        fi
    else
        print_kernel_message "kernel usbmon file not exist"
        return 1
    fi
    return 0
}

function insmod_kernel_usbmons()
{
    insmod_kernel_usbmon /vendor/lib64/modules/usb/usbmon.ko
    if [ $? -ne 0 ]
    then
        return 1;
    fi
    print_kernel_message "insmod usbmon kernel modules succ"
    return 0
}

function load_drivers()
{
    result=$(param get security.dsl.usbmon.state)
	print_kernel_message "insmod usbmon result:[$result]"
	result_first_char=${result:0:1}
    if [ "$result_first_char" = "1" ]; then
        print_kernel_message "insmod usbmon modules start"
        insmod_kernel_usbmons
    elif [ "$result_first_char" = "0" ]; then
        print_kernel_message "no need insmod usbmon modules"
    else
        print_kernel_message "err insmod usbmon modules"
    fi
    return $?
}

function main_user()
{
    print_kernel_message "load usbmon driver start, mode:$1"
 
    load_drivers
    if [ $? -eq 0 ];then
        print_kernel_message "load usbmon kernel succ"
    else
        print_kernel_message "load usbmon kernel fail"
        return 1;
    fi
}

#--------------------main-----------------
#in normal mode, the service run without argument.
if [ $# == 0 ] ; then
    main_user normal 
fi
