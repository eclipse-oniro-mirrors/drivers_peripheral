import("//build/ohos.gni")
 
ohos_prebuilt_etc("load_usbmon_driver_ohos") {
  source = "load_usbmon_driver_ohos"
  module_install_dir = "bin"
  install_enable = true
  install_images = [ "vendor" ]
  subsystem_name = "hdf"
  part_name = "drivers_peripheral_usb"
}
 
group("usb_load_usbmon_driver") {
  deps = [
    ":load_usbmon_driver_ohos",
  ]
}
