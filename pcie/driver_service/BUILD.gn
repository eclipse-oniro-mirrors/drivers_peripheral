import("//build/ohos.gni")

config("pcie_driver_host_service_config") {
  include_dirs = [ "include" ]
}

ohos_static_library("pcie_driver_host_service_core") {
  sources = [
    "src/pcie_host_service.cpp",
    "src/pcie_sysfs_scanner.cpp",
  ]

  public_configs = [ ":pcie_driver_host_service_config" ]

  external_deps = [
    "drivers_interface_pcie:pcie_interface_idl_headers",
    "cJSON:cjson",
    "c_utils:utils",
    "hdf_core:libhdf_utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "init:libbegetutil",
    "samgr:samgr_proxy",
  ]

  subsystem_name = "hdf"
  part_name = "drivers_peripheral_pcie"
}

ohos_shared_library("libpcie_driver_host_driver") {
  sources = [ "src/pcie_host.cpp" ]

  public_configs = [ ":pcie_driver_host_service_config" ]

  deps = [ ":pcie_driver_host_service_core" ]

  external_deps = [
    "drivers_interface_pcie:libpcie_interface_stub_1.0",
    "hdf_core:libhdf_host",
    "hdf_core:libhdf_ipc_adapter",
    "hdf_core:libhdf_utils",
    "hdf_core:libhdi",
    "hilog:libhilog",
    "init:seccomp",
    "ipc:ipc_single",
  ]

  shlib_type = "hdi"
  install_images = [ chipset_base_dir ]
  subsystem_name = "hdf"
  part_name = "drivers_peripheral_pcie"
}
